# Public URL of the deployed site (used for Open Graph / WhatsApp previews),
# e.g. https://your-project.vercel.app or your custom domain.
# Optional on Vercel: if unset (or blank) the production URL Vercel provides is
# used automatically. Only add it with a real value — never leave it empty.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional: RSVP collection endpoint (Google Apps Script web app or Supabase
# Edge Function). Leave unset to keep RSVPs in mock mode (stored on the device).
# NEXT_PUBLIC_RSVP_ENDPOINT=
