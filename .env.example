# Public URL of the deployed site (used for Open Graph / WhatsApp previews).
# On Vercel this is detected automatically; set it if you use a custom domain.
NEXT_PUBLIC_SITE_URL=

# Optional: RSVP collection endpoint (Google Apps Script web app or Supabase
# Edge Function). Leave empty to keep RSVPs in mock mode (stored on the device).
NEXT_PUBLIC_RSVP_ENDPOINT=
